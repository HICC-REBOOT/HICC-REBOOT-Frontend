### Navigation Hooks

```typescript
// ✅ CORRECT - Navigation hook usage
import { useNavigate, useLocation } from "react-router-dom";
import ROUTE from "@constants/route";

function Component() {
  const navigate = useNavigate();
  const location = useLocation();

  const handleNavigation = () => {
    navigate(ROUTE.COMMUNITY.WRITE);
  };

  const handleBack = () => {
    navigate(-1);
  };
}
```

### Route Protection

```typescript
// ✅ CORRECT - Protected route component
function ProtectedRoute({ children, requiredRole }: { children: React.ReactNode; requiredRole: string }) {
  const { user, isLoading } = useAuth();
  const navigate = useNavigate();

  useEffect(() => {
    if (!isLoading && !user) {
      navigate(ROUTE.LOGIN);
    }
  }, [user, isLoading, navigate]);

  if (isLoading) return <Loading />;
  if (!user) return null;

  return <>{children}</>;
}

// ✅ CORRECT - Usage in routes
<Route
  path={ROUTE.ADMIN.BASE}
  element={
    <ProtectedRoute requiredRole="admin">
      <Admin />
    </ProtectedRoute>
  }
>
```

### Route Parameters

```typescript
// ✅ CORRECT - Route parameter handling
import { useParams } from "react-router-dom";

function ArticleDetail() {
  const { id } = useParams<{ id: string }>();

  if (!id) {
    return <NotFound />;
  }

  const {
    data: article,
    isLoading,
    error,
  } = useGetArticleDetail({ articleId: parseInt(id, 10) });

  if (isLoading) return <Loading />;
  if (error) return <ErrorMessage error={error} />;
  if (!article) return <NotFound />;

  return <ArticleContent article={article} />;
}
```

### Loading and Error States

```typescript
// ✅ CORRECT - Route-level error handling
function App() {
  return (
    <ErrorBoundary fallback={<GlobalError />}>
      <Suspense fallback={<Loading />}>
        <Routes>{/* Routes */}</Routes>
      </Suspense>
    </ErrorBoundary>
  );
}
```

