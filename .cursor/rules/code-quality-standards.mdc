### Import Organization

```typescript
// ✅ CORRECT - Organized imports
// 1. React and external libraries
import React, { useState, useEffect } from "react";
import { useQuery } from "@tanstack/react-query";
import styled from "styled-components";

// 2. Internal components and utilities
import { Button } from "@components/common/button";
import { useAuth } from "@hooks/useAuth";
import { formatDate } from "@utils/time";

// 3. Types and constants
import { UserType } from "@types/UserType";
import { API_ENDPOINTS } from "@constants/api";

// 4. Styles
import * as S from "./style/Component.style";
```

### Error Handling Patterns

```typescript
// ✅ CORRECT - Proper error handling
function DataComponent() {
  const { data, isLoading, error } = useQuery({
    queryKey: ["data"],
    queryFn: fetchData,
  });

  if (isLoading) return <Loading />;
  if (error) return <ErrorMessage error={error} />;
  if (!data) return <NotFound />;

  return <DataDisplay data={data} />;
}

// ✅ CORRECT - Error boundary usage
function App() {
  return (
    <ErrorBoundary fallback={<GlobalError />}>
      <Router>
        <Routes />
      </Router>
    </ErrorBoundary>
  );
}
```

### Performance Optimization

```typescript
// ✅ CORRECT - React.memo usage
const ExpensiveComponent = React.memo(({ data }: Props) => {
  return <div>{/* Expensive rendering logic */}</div>;
});

// ✅ CORRECT - useMemo for expensive calculations
function Component({ items }: { items: Item[] }) {
  const processedItems = useMemo(() => {
    return items.filter((item) => item.isActive).map(processItem);
  }, [items]);

  return <ItemList items={processedItems} />;
}

// ✅ CORRECT - useCallback for event handlers
function Component({ onItemClick }: { onItemClick: (id: number) => void }) {
  const handleClick = useCallback(
    (id: number) => {
      onItemClick(id);
    },
    [onItemClick]
  );

  return <Button onClick={() => handleClick(1)} />;
}
```

