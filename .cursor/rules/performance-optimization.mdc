# Performance Optimization Rules

## ⚡ Performance Best Practices

### React Optimization Patterns

```typescript
// ✅ CORRECT - React.memo for expensive components
const ExpensiveList = React.memo(({ items }: { items: Item[] }) => {
  return (
    <div>
      {items.map((item) => (
        <ListItem key={item.id} item={item} />
      ))}
    </div>
  );
});

// ✅ CORRECT - useMemo for expensive calculations
function DataProcessor({ data }: { data: RawData[] }) {
  const processedData = useMemo(() => {
    return data
      .filter((item) => item.isValid)
      .map(transformData)
      .sort((a, b) => b.priority - a.priority);
  }, [data]);

  return <DataDisplay data={processedData} />;
}

// ✅ CORRECT - useCallback for event handlers
function ParentComponent() {
  const [items, setItems] = useState<Item[]>([]);

  const handleItemClick = useCallback((itemId: number) => {
    setItems((prev) => prev.filter((item) => item.id !== itemId));
  }, []);

  return <ChildComponent onItemClick={handleItemClick} />;
}
```

### MUST FOLLOW Rules

✅ **ALWAYS** use React.memo for components that re-render frequently
✅ **ALWAYS** use useMemo for expensive calculations
✅ **ALWAYS** use useCallback for event handlers passed to child components
✅ **ALWAYS** implement proper key props for list items
✅ **ALWAYS** use code splitting with React.lazy
✅ **ALWAYS** optimize bundle size with tree shaking
✅ **ALWAYS** implement proper loading states
✅ **ALWAYS** use Suspense for lazy-loaded components

### NEVER DO Rules

❌ **NEVER** create functions inside render methods
❌ **NEVER** forget to add key props to list items
❌ **NEVER** use index as key for dynamic lists
❌ **NEVER** create objects or arrays in render
❌ **NEVER** forget to handle loading states
❌ **NEVER** bundle large libraries unnecessarily
❌ **NEVER** forget to implement error boundaries

### Code Splitting

```typescript
// ✅ CORRECT - Lazy loading components
import React, { lazy, Suspense } from "react";
import Loading from "@components/common/loading/Loading";

const LazyComponent = lazy(() => import("./HeavyComponent"));

function App() {
  return (
    <Suspense fallback={<Loading />}>
      <LazyComponent />
    </Suspense>
  );
}

// ✅ CORRECT - Route-based code splitting
const Home = lazy(() => import("@pages/Home"));
const Calendar = lazy(() => import("@pages/Calendar"));
const Community = lazy(() => import("@pages/community/Community"));
```

### Bundle Optimization

```typescript
// ✅ CORRECT - Dynamic imports for large libraries
const HeavyLibrary = lazy(() => import("heavy-library"));

// ✅ CORRECT - Tree shaking friendly imports
import { Button } from "antd"; // Only imports Button
import { debounce } from "lodash-es"; // Only imports debounce

// ❌ WRONG - Importing entire libraries
import * as Antd from "antd";
import _ from "lodash";
```

### Image Optimization

```typescript
// ✅ CORRECT - Lazy loading images
import { LazyLoadImage } from "react-lazy-load-image-component";

function ImageComponent({ src, alt }: { src: string; alt: string }) {
  return (
    <LazyLoadImage
      src={src}
      alt={alt}
      effect="blur"
      placeholderSrc="/placeholder.jpg"
    />
  );
}

// ✅ CORRECT - Responsive images
const ResponsiveImage = styled.img`
  width: 100%;
  height: auto;

  ${({ theme }) => theme.media.mobile`
    max-width: 100%;
  `}
`;
```

### Query Optimization

```typescript
// ✅ CORRECT - Optimized query configuration
function useOptimizedQuery() {
  return useQuery({
    queryKey: ["data"],
    queryFn: fetchData,
    staleTime: 5 * 60 * 1000, // 5 minutes
    cacheTime: 10 * 60 * 1000, // 10 minutes
    refetchOnWindowFocus: false,
    retry: 1,
    retryDelay: 1000,
  });
}

// ✅ CORRECT - Query invalidation
function useMutationWithInvalidation() {
  const queryClient = useQueryClient();

  return useMutation({
    mutationFn: updateData,
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["data"] });
    },
  });
}
```

### Memory Management

```typescript
// ✅ CORRECT - Cleanup in useEffect
function Component() {
  useEffect(() => {
    const subscription = someService.subscribe();

    return () => {
      subscription.unsubscribe();
    };
  }, []);

  // Component logic
}

// ✅ CORRECT - Abort controller for fetch requests
function useFetchWithAbort(url: string) {
  useEffect(() => {
    const abortController = new AbortController();

    fetch(url, { signal: abortController.signal })
      .then((response) => response.json())
      .catch((error) => {
        if (error.name !== "AbortError") {
          console.error("Fetch error:", error);
        }
      });

    return () => {
      abortController.abort();
    };
  }, [url]);
}
```

